# PostgreSQL Container Configuration (Docker Compose)
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=replace_with_a_strong_password

# Application Database Configuration
# Also used by the local operator provisioning CLI. Exported PG* values take
# precedence over .env; verify its displayed host/port/database/role before writes.
# --database/--role confirm this connection; they do not select another database.
# Keep database credentials private; project API keys do not grant operator access.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lumen
PGUSER=lumen
PGPASSWORD=replace_with_a_strong_password

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# API listener (local-only example; application default HOST is 0.0.0.0)
HOST=127.0.0.1
PORT=3000

# Browser CORS: exact comma-separated origins. No wildcards, paths, queries,
# fragments, or credentials. Missing means no browser origins are allowed.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173

# Clerk session-token verification (public JWKS only; no secret key).
# CLERK_ISSUER must be the exact https Frontend API origin for one instance.
# CLERK_AUTHORIZED_PARTIES must list exact frontend origins; azp must match.
# CLERK_JWKS_URL is optional and must be https on the CLERK_ISSUER origin.
# CLERK_CLOCK_TOLERANCE_SECONDS is optional, default 5, maximum 60.
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://127.0.0.1:4173
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_CLOCK_TOLERANCE_SECONDS=5

# Optional shared storage: set the same absolute path for API and workers.
# If omitted, defaults to ./storage relative to each process working directory.
# STORAGE_BASE_DIR=/absolute/path/to/lumen/storage

# Executable names or literal paths, including paths containing spaces.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional encoder override; output is still validated as H.264.
# FFMPEG_VIDEO_ENCODER=libx264

TRANSCODING_CONCURRENCY=2
TRANSCODING_TIMEOUT_MS=120000
TRANSCODING_MAX_OUTPUT_BYTES=524288000
TRANSCODING_MAX_STDERR_BYTES=65536
TRANSCODING_THREADS=2
FFPROBE_TIMEOUT_MS=10000
FFPROBE_MAX_BUFFER_BYTES=1048576
# Optional Redis database index, default 0.
REDIS_DB=0

# These are DEVELOPMENT settings. Never point integration tests at these services.
# Disposable test credentials belong in ignored .env.integration and are generated
# independently; see .env.integration.example and docs/isolated-integration-tests.md.

# Operator-only webhook management (no delivery worker yet).
# Exact lower-case DNS hostnames, comma-separated; no wildcards or IPs.
# WEBHOOK_HOSTNAME_ALLOWLIST=hooks.example.com
# External key identifier (1–64 ASCII letters/digits/_/-, first character alphanumeric).
# WEBHOOK_ENCRYPTION_KEY_ID=local-a
# WEBHOOK_ENCRYPTION_KEYS is a JSON object mapping IDs to 64 lower-case hex characters
# (32 random bytes per AES key). Supply through a secret manager or ignored mode-0600
# environment file; no actual key belongs in this template or shell arguments.
# Keep all referenced external keys available, including previous-secret keys.
# WEBHOOK_ENCRYPTION_KEYS=
