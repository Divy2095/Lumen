# PostgreSQL Container Configuration (Docker Compose)
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=replace_with_a_strong_password

# Application Database Configuration
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lumen
PGUSER=lumen
PGPASSWORD=replace_with_a_strong_password

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# API listener (local-only example; application default HOST is 0.0.0.0)
HOST=127.0.0.1
PORT=3000

# Optional shared storage: set the same absolute path for API and workers.
# If omitted, defaults to ./storage relative to each process working directory.
# STORAGE_BASE_DIR=/absolute/path/to/lumen/storage

# Executable names or literal paths, including paths containing spaces.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional encoder override; output is still validated as H.264.
# FFMPEG_VIDEO_ENCODER=libx264

TRANSCODING_CONCURRENCY=2
TRANSCODING_TIMEOUT_MS=120000
TRANSCODING_MAX_OUTPUT_BYTES=524288000
TRANSCODING_MAX_STDERR_BYTES=65536
TRANSCODING_THREADS=2
FFPROBE_TIMEOUT_MS=10000
FFPROBE_MAX_BUFFER_BYTES=1048576
# Optional Redis database index, default 0.
REDIS_DB=0

# These are DEVELOPMENT settings. Never point integration tests at these services.
# Disposable test credentials belong in ignored .env.integration and are generated
# independently; see .env.integration.example and docs/isolated-integration-tests.md.
